server:
  grpc_port: 50051
  http_port: 8080
  ingest_enabled: true

ingestor:
  buffer_size: 1000

buffer:
  type: "channel"      # channel (in-process) or redis (shared across replicas)
  redis:
    addr: "localhost:6379"
    password: ""
    db: 0
    key: "ingestor:buffer"

worker:
  num_workers: 5
  batch_size: 100
  batch_timeout: "5s"

sinks:
  active: ["log"]  # log, kafka, http
  kafka:
    brokers: ["localhost:9092"]
    topic: "events"
  http:
    url: "https://webhook.example.com/events"
    timeout: "5s"
dlq:
  enabled: true
  type: "file"  # file, kafka
  file:
    dir: "data/dlq"
  kafka:
    brokers: ["localhost:9092"]
    topic: "events-dlq"

logging:
  level: "info"   # debug, info, warn, error
  format: "json"   # json or text

shutdown:
  timeout: "30s"   # max time to drain buffer before forcing exit
